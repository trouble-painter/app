      "program": "lib/main_dev.dart",
      "args": ["--flavor", "dev", "--target", "lib/main_dev.dart", "--dart-define=LOCAL_SERVER=10.0.2.2:8081"]
    },
    {
      "name": "app (prod)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_prod.dart",
